{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Dependencies are installed inside the daemon image'",
  "buildCommand": "",
  "outputDirectory": "deploy/signal-bot/site",
  "ignoreCommand": "sh deploy/signal-bot/ignore-build.sh",
  "daemons": {
    "signal-bot": {
      "root": ".",
      "entrypoint": "Dockerfile.signal-bot",
      "instances": {
        "iad1": 1
      },
      "resources": {
        "requests": {
          "memory": "1Gi"
        }
      },
      "terminationGracePeriodSeconds": 30
    }
  }
}
