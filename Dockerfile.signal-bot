# The signal bot only needs discord.js, postgres, dotenv and tsx, so it installs
# from its own small lock in deploy/signal-bot instead of the web app's (next,
# three, etc.). That keeps each image pushed to the registry small.
FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
COPY deploy/signal-bot/package.json deploy/signal-bot/package-lock.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=dependencies /app/node_modules ./node_modules
COPY tsconfig.json ./
COPY deploy/signal-bot/package.json ./package.json
COPY lib/signals.ts lib/signal-delivery.ts ./lib/
COPY scripts/signal-bot.ts ./scripts/signal-bot.ts
USER node
CMD ["node_modules/.bin/tsx", "scripts/signal-bot.ts"]
