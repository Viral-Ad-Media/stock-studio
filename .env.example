# Postgres connection for the stocks schema (Supabase pooler, transaction mode)
# Username format for the pooler is role.project-ref
DATABASE_URL=postgres://stocks_app.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase project ref hosting the stocks schema (used by Claude Code skills via MCP execute_sql)
SUPABASE_PROJECT_ID=

# Supabase Auth — public URL + anon (publishable) key, from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key for the automated backend worker (Phase 3) — not yet used
# by anything in Phase 1/2.
ANTHROPIC_API_KEY=

# Shared secret the Postgres trigger/cron worker sends when calling
# /api/engine/run (Phase 3) — not yet used.
ENGINE_WEBHOOK_SECRET=

# Stripe (Phase 4) — not yet used.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
