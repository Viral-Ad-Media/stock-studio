# =============================================================================
# Core database & Supabase Auth
# =============================================================================

# Postgres connection for the stocks schema (Supabase pooler, transaction mode).
# Username format for the pooler is role.project-ref.
DATABASE_URL=postgres://stocks_app.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase project ref hosting the stocks schema (for read-only inspection via Supabase SQL tools).
SUPABASE_PROJECT_ID=

# Supabase Auth — public URL + anon (publishable) key, from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of the deployed app, e.g. https://app.example.com — used for login
# confirmation redirects, canonicals, sitemaps, and Stripe success/cancel URLs.
# Set in production: behind a reverse proxy the server sees 0.0.0.0:$PORT (see lib/origin.ts;
# lib/site.ts falls back to RENDER_EXTERNAL_URL / VERCEL_PROJECT_PRODUCTION_URL when unset).
NEXT_PUBLIC_APP_URL=
# Optional local/container HTTP port for `npm start` (default 3200).
PORT=

# =============================================================================
# Automated research worker & SR 11-7 model risk controls (app/api/engine/run)
# =============================================================================

ANTHROPIC_API_KEY=
# Must match the Supabase Vault secret `engine_webhook_secret` (sent as x-engine-secret).
ENGINE_WEBHOOK_SECRET=

# 1 = automate web-research variants (full, memo, watchlist, movers…) via the hosted
# web_search tool. Keep unset (disabled) until the 20-study SR 11-7 golden-set traceability
# gate passes; while unset, web-research jobs wait for the manual engine CLI.
ENGINE_WEB_RESEARCH=

# Daily UTC ceiling in USD on automated Anthropic spend across research jobs (jobs.cost_usd)
# and setup-bot desk notes (setup_scans.cost_usd). Default 25; opens ops warning at 70%
# and holds the queue with a critical ops alert at 100%. Set <= 0 to disable.
ENGINE_DAILY_SPEND_CAP_USD=25

# Optional worker timing budgets (ms):
# - ENGINE_INVOCATION_BUDGET_MS: total per-invocation budget (default 280000; keep below 300s serverless maxDuration)
# - ENGINE_MIN_CLAIM_MS: minimum time remaining to claim another job (default 150000)
# - ENGINE_MAX_CALL_MS: timeout per single Anthropic API call (default 170000)
# On long-lived hosts (e.g. Render) deep-research jobs can use larger budgets: 720000 / 150000 / 600000.
ENGINE_INVOCATION_BUDGET_MS=
ENGINE_MIN_CLAIM_MS=
ENGINE_MAX_CALL_MS=

# Reasoning effort for quick takes, scripts, and watchlist refreshes (low | medium | high; default medium).
ENGINE_SHORT_FORMAT_EFFORT=

# =============================================================================
# Stripe billing & privileged database roles
# =============================================================================

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe webhook ONLY: pooler URL for the stocks_billing role (the only role allowed to
# grant access/credits). User format: stocks_billing.PROJECT_REF. Set role password in SQL:
#   ALTER ROLE stocks_billing WITH PASSWORD '...';
BILLING_DATABASE_URL=

# Super-admin console writes (/admin): pooler URL for the stocks_admin role.
# User format: stocks_admin.PROJECT_REF. Without it, /admin is read-only.
ADMIN_DATABASE_URL=

# Recurring monthly/yearly price IDs per plan (amounts in lib/plans.ts) + one-time credit pack.
STRIPE_PRICE_SILVER_MONTHLY=
STRIPE_PRICE_SILVER_YEARLY=
STRIPE_PRICE_GOLD_MONTHLY=
STRIPE_PRICE_GOLD_YEARLY=
STRIPE_PRICE_DIAMOND_MONTHLY=
STRIPE_PRICE_DIAMOND_YEARLY=
STRIPE_PRICE_CREDIT_PACK=
# Credits granted per pack purchase (default 10; matches lib/billing.ts).
STRIPE_CREDITS_PER_PACK=10

# =============================================================================
# Market data fallback (optional, lib/alpaca.ts)
# =============================================================================

# Free Alpaca account (paper keys work) used when Yahoo Finance rate-limits the host.
# Note: Alpaca free tier returns single-exchange IEX volume; volume-ratio setup bots
# (breakout_52w, volume_surge) are automatically skipped when bars come from Alpaca.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# =============================================================================
# Web Push notifications (optional, RFC 8291 / 8292 VAPID)
# =============================================================================

# Generate a fresh P-256 VAPID keypair with: npm run vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Optional server-only alias if NEXT_PUBLIC_VAPID_PUBLIC_KEY is not exposed at build time:
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI included in VAPID JWTs (mailto:... or https://...; defaults to mailto:<site email>).
VAPID_SUBJECT=

# =============================================================================
# Discord signal bot & Supabase signal-relay (optional, separate worker / secrets)
# =============================================================================
# In production, keep these in /etc/signal-bot/env (see deploy/signal-bot/env.example)
# or Supabase Edge Function secrets (see supabase/functions/signal-relay/README.md).
# Locally, scripts/signal-bot.ts falls back to .env.local.

DISCORD_TOKEN=
# Pooler URL for the insert/read-only stocks_signals role (stocks_signals.PROJECT_REF).
SIGNALS_DATABASE_URL=
INPUT_CHANNEL_ID=
SIGNALS_CHANNEL_ID=
GOLD_SIGNALS_CHANNEL_ID=
SILVER_SIGNALS_CHANNEL_ID=
# Comma-separated numeric Discord user IDs authorized to post trade calls.
SIGNAL_POSTER_IDS=
SIGNAL_FOOTER=
SIGNAL_DISCLAIMER=
# Shared x-relay-secret header for supabase/functions/signal-relay when invoked by pg_cron.
SIGNAL_RELAY_SECRET=
# Optional docker-compose override for signal-bot env_file path (default /etc/signal-bot/env).
SIGNAL_BOT_ENV_FILE=

# =============================================================================
# Sweep scanner capture worker (optional, capture-only — live alerts disabled)
# =============================================================================
# Directory shared read-only with /admin/sweeps (default .sweep-data locally, /data/sweep in Docker).
SWEEP_DATA_DIR=
# Path to the ranked scan_universe.json file consumed by scripts/sweep-scanner.mjs.
SWEEP_UNIVERSE_PATH=
