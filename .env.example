# Postgres connection for the stocks schema (Supabase pooler, transaction mode)
# Username format for the pooler is role.project-ref
DATABASE_URL=postgres://stocks_app.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase project ref hosting the stocks schema (used by Claude Code skills via MCP execute_sql)
SUPABASE_PROJECT_ID=

# Supabase Auth — public URL + anon (publishable) key, from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of the deployed app, e.g. https://app.example.com — used for the login
# confirmation redirect and Stripe success/cancel URLs. Set it in production: behind a host's
# proxy the server sees itself as 0.0.0.0:$PORT (see lib/origin.ts).
NEXT_PUBLIC_APP_URL=

# --- Automated worker (app/api/engine/run) ---
ANTHROPIC_API_KEY=
# Must match the Supabase Vault secret `engine_webhook_secret` (sent as x-engine-secret).
ENGINE_WEBHOOK_SECRET=
# 1 = also automate web-research variants (full, memo, watchlist, movers…) via the hosted
# web_search tool. Leave unset until that output is validated; those jobs then wait for the
# manual /build-studies path.
ENGINE_WEB_RESEARCH=
# Optional tuning (ms): total per-invocation budget (default 280000, keep under the route's
# 300s maxDuration) and the minimum time left to start another job (default 150000).
ENGINE_INVOCATION_BUDGET_MS=
ENGINE_MIN_CLAIM_MS=

# --- Stripe (hosted Checkout, one-time payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe webhook ONLY: pooler URL for the stocks_billing role (the only role allowed to
# grant access/credits). User format stocks_billing.PROJECT_REF. The role has no password
# until you set one in the Supabase SQL editor: ALTER ROLE stocks_billing WITH PASSWORD '...';
BILLING_DATABASE_URL=
# Price ids from the Stripe dashboard: one-time access fee, and one credit pack.
STRIPE_PRICE_ACCESS=
STRIPE_PRICE_CREDIT_PACK=
# Credits granted per pack purchase (default 20).
STRIPE_CREDITS_PER_PACK=
