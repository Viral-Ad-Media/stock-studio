# Copy to /etc/signal-bot/env (root:root, mode 600) and fill in. Never commit the real file.
DISCORD_TOKEN=
INPUT_CHANNEL_ID=
SIGNALS_CHANNEL_ID=
# Optional plan channels: Gold gets the 2 weekly picks, Silver the monthly pick (and their follow-ups).
GOLD_SIGNALS_CHANNEL_ID=
SILVER_SIGNALS_CHANNEL_ID=
# Discord user IDs allowed to post signals, comma-separated (Developer Mode -> right-click user -> Copy User ID).
SIGNAL_POSTER_IDS=
# Neon pooled connection, stocks_signals role: postgresql://stocks_signals:<password>@ep-PROJECT-pooler.REGION.aws.neon.tech/stockstudio?sslmode=require
SIGNALS_DATABASE_URL=
# Optional
SIGNAL_FOOTER=I Hate 9-5 Signals
SIGNAL_DISCLAIMER=Trading involves risk of loss. Not personalized financial advice.
